# Airtable lead capture for the demo quiz (functions/api/lead.ts).
# Set these as encrypted environment variables on the host — never commit real
# values. The token is write-scoped: it must never reach the browser bundle, so
# it is deliberately NOT prefixed with VITE_ (Vite only exposes VITE_* to the
# client, and these are read server-side only).

# Personal access token, scopes: data.records:read + data.records:write,
# restricted to the Azurro Leads base only.
AIRTABLE_TOKEN=

# Azurro Leads
AIRTABLE_BASE=appCn9bzkTiQqoUiq

# Leads
AIRTABLE_TABLE=tblfzCjQnBhdGowB5

# Optional. Unset means no webhook fires on completion. Receives a POST with
# {"text": "New Azurro lead — ..."} and is fire-and-forget: a failure here never
# affects the visitor's submission.
NOTIFY_URL=
